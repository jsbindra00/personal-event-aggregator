{
  "name": "personal-event-aggregator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @event-agg/server --filter @event-agg/web dev",
    "model:check": "tsx scripts/check-local-model.ts",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@event-agg/server": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
